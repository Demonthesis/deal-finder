# Copy to /etc/dealfinder/env (owner root, group dealfinder, mode 0640) and fill in.
# Lines you don't need can stay empty.

# Web app address. 127.0.0.1 (the default) keeps it local to the container: reach it through
# a tunnel or reverse proxy that does its own login (e.g. Cloudflare Tunnel + Access), and
# leave DEALFINDER_PASSWORD empty. 0.0.0.0 serves it on the network and needs a password.
DEALFINDER_HOST=127.0.0.1
# Web app login. Empty turns the login off, which is allowed only on 127.0.0.1.
DEALFINDER_PASSWORD=
# Keeps logins valid across restarts; any long random string (openssl rand -hex 32).
DEALFINDER_SECRET=

# LLM for adapter llm.
ANTHROPIC_API_KEY=
# For an openai_compatible provider (e.g. Z.ai) instead:
# LLM_API_KEY=

# Official site APIs.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
BESTBUY_API_KEY=

# Alert channel: fill in the one set in alerts.channel.
DISCORD_WEBHOOK_URL=
NTFY_TOPIC_URL=
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
