# Copy to /etc/dealfinder/env (owner root, group dealfinder, mode 0640) and fill in.
# Lines you don't need can stay empty.

# Web app login (required: the app listens on the network).
DEALFINDER_PASSWORD=
# Keeps logins valid across restarts; any long random string (openssl rand -hex 32).
DEALFINDER_SECRET=

# LLM for adapter llm.
ANTHROPIC_API_KEY=
# For an openai_compatible provider (e.g. Z.ai) instead:
# LLM_API_KEY=

# Official site APIs.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
BESTBUY_API_KEY=

# Alert channel: fill in the one set in alerts.channel.
DISCORD_WEBHOOK_URL=
NTFY_TOPIC_URL=
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
