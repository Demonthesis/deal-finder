[Unit]
Description=Deal Finder (watches sites for deals, web app on port 8080)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dealfinder
Group=dealfinder
# Persistent data (database, HTTP cache, config) lives here; mount a volume at this path.
WorkingDirectory=/var/lib/dealfinder
# API keys, alert channel keys, DEALFINDER_HOST and DEALFINDER_PASSWORD (see deploy/env.example).
# The web app's address comes from DEALFINDER_HOST (default 127.0.0.1).
EnvironmentFile=/etc/dealfinder/env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/dealfinder/browsers
ExecStart=/opt/dealfinder/.venv/bin/dealfinder serve \
    --config /var/lib/dealfinder/watchlists.yaml \
    --db /var/lib/dealfinder/dealfinder.db \
    --port 8080
Restart=on-failure
RestartSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/dealfinder

[Install]
WantedBy=multi-user.target
